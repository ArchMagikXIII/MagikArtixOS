#!/bin/bash

# Magikos in-repo installer. Two modes:
#
#   Full-disk install: boots from any live media with network access, wipes a
#   disk, installs Magikos onto it, and hands off to the same target-side
#   setup the packaged ISO uses (magikos-apply-system in the target chroot).
#
#   Existing-system adoption (--existing): applies Magikos onto the currently
#   running system — plants the tree, best-effort packages, then
#   magikos-apply-system directly. No partitioning, no bootloader changes.
#
# Usage: sudo ./installer/magikos-install --disk /dev/sdX --user alice [options]
#        sudo ./installer/magikos-install --existing [options]
# See installer/README.md for the full contract and current limitations.

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
TARGET="/mnt"
LUKS_NAME="cryptroot"

DISK=""
INSTALL_USER=""
INSTALL_PASSWORD=""
HOSTNAME=""
TIMEZONE=""
ENCRYPT=1
AUTOLOGIN=0
BACKEND="${MAGIKOS_PKG_BACKEND:-}"
ALLOW_BIOS=0
ASSUME_YES=0
DRY_RUN=0
EXISTING_MODE=0
CONFIG_FILE=""
CREDS_FILE=""
# -1 = auto (enable when the CachyOS repo is not already present); 0 = off; 1 = on.
CACHYOS_REPOS=-1

LOG_FILE="${MAGIKOS_INSTALL_LOG_FILE:-/tmp/magikos-install.log}"
PKG_FAILURES=()
# Repo packages whose dependency closure cannot be satisfied on this host
# (systemd-bound packages on an OpenRC system, for example). They are
# reported at the end but never retried through yay, where a repo package
# could not be fixed anyway.
PKG_UNRESOLVABLE=()
TARGET_HOOK_MASKS=()

log() {
  printf '\033[32m==> %s\033[0m\n' "$1"
}

warn() {
  printf '\033[33m==> %s\033[0m\n' "$1" >&2
}

# Progress banner. STEP_N counts through the PHASES array in main(), so the
# numbering stays contiguous and matches the actual phase sequence (mirrors
# the orchestrated-phase format the ISO uses).
STEP_N=0
TOTAL_STEPS=0
step() {
  STEP_N=$((STEP_N + 1))
  printf '\n\033[1;36m[%s/%s] %s\033[0m\n' "$STEP_N" "$TOTAL_STEPS" "$1"
}

die() {
  printf '\033[31mError: %s\033[0m\n' "$1" >&2
  exit 1
}

usage() {
  cat <<USAGE
Usage:
  magikos-install --disk DEVICE --user NAME [options]   full-disk install (wipes the disk)
  magikos-install --existing [--user NAME] [options]    adopt the currently running system

Required for full-disk install:
  --disk DEVICE     Target disk (whole device, e.g. /dev/vda). Its contents are destroyed.
  --user NAME       Non-root user to create.
  --user-password PWD  Password for the new user (skip the interactive prompt;
                    required for unattended/--yes installs on serial consoles)

Alternative to --disk/--user/--hostname/--timezone/...:
  --config-file FILE  JSON install plan written by installer/configurator (or an
                    autoinstall drive). Overrides every flag below except
                    --existing/--allow-bios/--yes/--dry-run.
  --creds-file FILE   JSON user credentials ({ "users": [{ "username": .., "password": .. }] }).
                    Implied by the configurator handoff; required with --config-file.

Options:
  --existing        Adopt the running system: no partitioning, no bootloader changes.
                    Defaults to the invoking user when --user is omitted.
  --hostname NAME   Target hostname (default: magikos; ignored with --existing)
  --timezone TZ     IANA timezone (default: the live media's timezone; ignored with --existing)
  --no-encrypt      Skip LUKS2 encryption of the root partition
  --autologin       Log the user in automatically at the MagikOS login screen
                    (default: ask for the password at every boot)
  --backend BE      pacman | auto (default: auto-detect on the live media)
  --cachyos-repos   Add the CachyOS repositories before packages are installed.
                    Auto-enabled when they are missing and a confirmation was
                    not possible; --no-cachyos-repos forces them off.
  --no-cachyos-repos  Do not add the CachyOS repositories (not recommended:
                    the Magikos package set contains CachyOS-only names that
                    would otherwise be built from the AUR).
  --allow-bios      Let a BIOS/CSM-booted machine continue (only for OS/VM
                    tests; a real deployment must boot UEFI for limine+ESP)
  --dry-run         Print every action without touching anything
  -h, --help        This help
USAGE
}

while (($#)); do
  case "$1" in
    --disk) DISK="$2"; shift 2 ;;
    --user) INSTALL_USER="$2"; shift 2 ;;
    --user-password) INSTALL_PASSWORD="$2"; shift 2 ;;
    --config-file) CONFIG_FILE="$2"; shift 2 ;;
    --creds-file) CREDS_FILE="$2"; shift 2 ;;
    --hostname) HOSTNAME="$2"; shift 2 ;;
    --timezone) TIMEZONE="$2"; shift 2 ;;
    --no-encrypt) ENCRYPT=0; shift ;;
    --autologin) AUTOLOGIN=1; shift ;;
    --backend) BACKEND="$2"; shift 2 ;;
    --cachyos-repos) CACHYOS_REPOS=1; shift ;;
    --no-cachyos-repos) CACHYOS_REPOS=0; shift ;;
    --allow-bios) ALLOW_BIOS=1; shift ;;
    --yes) ASSUME_YES=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --existing) EXISTING_MODE=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

run() {
  if (( DRY_RUN )); then
    printf '[dry-run] %s\n' "$*"
  else
    "$@"
  fi
}

# All file writes go through here so --dry-run genuinely touches nothing.
write_file() {
  local path="$1" content="$2"
  if (( DRY_RUN )); then
    printf '[dry-run] write %s (%s bytes)\n' "$path" "${#content}"
  else
    run mkdir -p "$(dirname "$path")"
    printf '%s' "$content" >"$path"
  fi
}

# Everything that must happen inside the target goes through here, so the
# virtual kernels are bound once and the same call works for both backends.
chroot_exec() {
  local cmd="$1"
  if (( DRY_RUN )); then
    printf '[dry-run] chroot %s: %s\n' "$TARGET" "$cmd"
  else
    chroot "$TARGET" /bin/bash -lc "$cmd"
  fi
}

require_tools() {
  local missing=()
  local tool
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || missing+=("$tool")
  done
  if ((${#missing[@]} > 0)); then
    die "Missing required tools on the live media: ${missing[*]}"
  fi
}

# Load an installer/configurator handoff: two JSON files that replace the
# interactive flag gathering. The configurator (and any autoinstall drive)
# produces exactly these, so the two paths can never drift. The handoff is the
# orchestrator's first act — verify it, name the broken field, and refuse to
# proceed on anything malformed rather than surface later as a cryptic chroot
# failure.
load_install_config() {
  require_tools jq

  [[ -r $CONFIG_FILE ]] || die "Config file not readable: $CONFIG_FILE"
  [[ -r $CREDS_FILE ]] || die "Credentials file not readable: $CREDS_FILE"

  local jq_err config_mode creds_mode
  config_mode=$(jq -r '.mode // "full_disk"' "$CONFIG_FILE" 2>/dev/null) ||
    die "Config file is not valid JSON: $CONFIG_FILE"
  creds_mode=$(jq -r 'if (.users | length) > 0 then "full_disk" else "" end' "$CREDS_FILE" 2>/dev/null) ||
    die "Credentials file is not valid JSON: $CREDS_FILE"

  case $config_mode in
    full_disk) ;;
    existing)
      EXISTING_MODE=1
      # A handcrafted --existing handoff may carry the user to adopt; also
      # accept a creds file so the configurator-style pipes Just Work.
      local maybe_user=""
      maybe_user=$(jq -r '.users[0].username // ""' "$CREDS_FILE" 2>/dev/null || true)
      [[ -z $INSTALL_USER && -n $maybe_user ]] && INSTALL_USER="$maybe_user"
      return 0
      ;;
    *) die "Config file has unknown mode: $config_mode" ;;
  esac

  if [[ -z $creds_mode ]]; then
    die "Credentials file carries no users: $CREDS_FILE"
  fi

  DISK=$(jq -r '.disk // ""' "$CONFIG_FILE")
  HOSTNAME=$(jq -r '.hostname // ""' "$CONFIG_FILE")
  TIMEZONE=$(jq -r '.timezone // ""' "$CONFIG_FILE")
  ENCRYPT=$(jq -r 'if .encrypt == true then 1 else 0 end' "$CONFIG_FILE")
  AUTOLOGIN=$(jq -r 'if .autologin == true then 1 else 0 end' "$CONFIG_FILE")
  INSTALL_USER=$(jq -r '.users[0].username // ""' "$CREDS_FILE")
  INSTALL_PASSWORD=$(jq -r '.users[0].password // ""' "$CREDS_FILE")

  # The configurator already asked about CachyOS and the final wipe; an
  # autoinstall drive has made its choice explicit. Never re-ask interactively
  # downstream of a handoff.
  CACHYOS_REPOS=$(jq -r 'if .cachyos_repos == false then 0 else 1 end' "$CONFIG_FILE")
  ASSUME_YES=1

  if [[ -z $DISK ]]; then
    die "Config file has no disk: $CONFIG_FILE"
  fi
  if [[ -z $INSTALL_USER || $INSTALL_USER == "root" ]]; then
    die "Config file has no usable username: $CREDS_FILE"
  fi
}

ask_confirm() {
  if (( ASSUME_YES || DRY_RUN )); then
    return 0
  fi
  local question="$1"
  if command -v gum >/dev/null 2>&1; then
    gum confirm --default=false "$question"
  else
    read -r -p "$question [y/N] " reply
    [[ $reply == y || $reply == Y ]]
  fi
}

ask_password() {
  local prompt="$1" pass confirm attempt
  for attempt in $(seq 1 5); do
    read -rs -p "$prompt: " pass
    echo
    read -rs -p "Confirm: " confirm
    echo
    if [[ -n $pass && $pass == "$confirm" ]]; then
      break
    fi
    echo "Passwords empty or mismatched; try again." >&2
  done
  [[ -n $pass && $pass == "$confirm" ]] || die "Could not obtain a matching password after 5 attempts."
  printf '%s' "$pass"
}

# Ask for a value on the live media when it was not given on the command line,
# so a bare "sudo ./magikos-install" still gets through the wizard instead of
# dying on a missing flag. A blank answer with no default is rejected and
# re-prompted rather than slipping through to a cryptic flag error.
prompt_value() {
  local label="$1" default="${2:-}" answer
  while :; do
    if [[ -n $default ]]; then
      read -r -p "$label [$default]: " answer || return 1
      answer=${answer:-$default}
      printf '%s' "$answer"
      return 0
    else
      read -r -p "$label: " answer || return 1
      if [[ -n $answer ]]; then
        printf '%s' "$answer"
        return 0
      fi
      echo "Value cannot be empty; try again." >&2
    fi
  done
}

# The live media's candidate target disks, one per line for plating in a prompt.
# Excludes virtual devices (zram, loop, ram) that must never be offered as a
# wipe target.
list_block_devices() {
  if command -v lsblk >/dev/null 2>&1; then
    lsblk -dpno NAME,TYPE,SIZE,MODEL 2>/dev/null |
      awk '$2=="disk" && $1 !~ /\/(zram|loop|ram)/ {print $1" "$3" "$4}'
  fi
}

# The whole disk the live media is currently rooted on, if any (e.g. /dev/vda
# when / is mounted from /dev/vda2). Wiping this device destroys the running
# system, so it must never be offered as a target. btrfs subvolumes show up as
# a "[/@]" suffix on the source, so that is stripped before resolving parents.
live_media_root_disk() {
  command -v findmnt >/dev/null 2>&1 || return 0
  local x root dev holder
  root=$(findmnt -no SOURCE / 2>/dev/null || true)
  [[ -n $root ]] || return 0
  dev="${root%%\[*}"
  while [[ -n $dev && -b $dev ]]; do
    holder=$(lsblk -no PKNAME "$dev" 2>/dev/null || true)
    case $holder in
      /dev/*) x=$holder ;;
      /*) x=$holder ;;
      ?*) x="/dev/$holder" ;;
      *) break ;;
    esac
    if [[ $x == "$dev" || ! -b $x ]]; then
      break
    fi
    dev=$x
  done
  if [[ -n $dev && -b $dev ]]; then
    printf '%s' "$dev"
  fi
  return 0
}

preflight() {
  if (( EUID != 0 )); then
    die "Run as root (sudo)."
  fi

  export MAGIKOS_PATH="$ROOT"
  source "$ROOT/bin/magikos-pkg-backend"

  # The only supported backend is pacman (Arch/CachyOS); magikos-pkg-backend
  # has already required it on the live media.
  BACKEND=pacman

  require_tools rsync

  export MAGIKOS_INSTALL_LOG_FILE="$LOG_FILE"

  # An installer/configurator (or autoinstall drive) handoff replaces the flag
  # gathering entirely: it may even switch us into --existing mode. Load it the
  # moment required tools for JSON parsing are known present, before any
  # interactive branch decides what to do.
  if [[ -n $CONFIG_FILE || -n $CREDS_FILE ]]; then
    load_install_config
  fi

  if (( EXISTING_MODE )); then
    if [[ -z $INSTALL_USER ]]; then
      INSTALL_USER=${SUDO_USER:-}
    fi
    if [[ -z $INSTALL_USER || $INSTALL_USER == "root" ]]; then
      die "--existing needs --user NAME (or run under sudo so \$SUDO_USER resolves; got: ${INSTALL_USER:-nothing})."
    fi
    log "Adopting the running system: backend $BACKEND, user $INSTALL_USER"
    if ! ask_confirm "Install Magikos onto the running system? Shipped defaults will overwrite matching files in ~$INSTALL_USER at next login."; then
      die "Aborted."
    fi
    prompt_cachyos
    return 0
  fi

  # Interactive wizard for a bare invocation: when required flags were not
  # given on the command line, ask on the live media instead of failing with a
  # cryptic message. Only prompts when input is a terminal so scripted runs
  # stay strict.
  if (( ! EXISTING_MODE )) && [[ -t 0 ]]; then
    if [[ -z $DISK ]]; then
      log "Available block devices:"
      list_block_devices | sed 's/^/  /'
      local single_disk=""
      mapfile -t _devs < <(list_block_devices | awk '{print $1}')
      if ((${#_devs[@]} == 1)); then
        single_disk="${_devs[0]}"
      fi
      DISK=$(prompt_value "Target disk to erase and install onto" "$single_disk")
    fi
    if [[ -z $INSTALL_USER ]]; then
      INSTALL_USER=$(prompt_value "Non-root user to create" "${SUDO_USER:-}")
    fi
    if [[ -z $HOSTNAME ]]; then
      HOSTNAME=$(prompt_value "Hostname" "magikos")
    fi
    if (( ASSUME_YES == 0 )); then
      if command -v gum >/dev/null 2>&1; then
        if ! gum confirm --default=true "Encrypt the root partition with LUKS2?"; then
          ENCRYPT=0
        fi
      else
        local reply=""
        read -r -p "Encrypt the root partition with LUKS2? [Y/n] " reply || reply=""
        [[ $reply == n || $reply == N ]] && ENCRYPT=0
      fi
    fi
    prompt_cachyos
  fi

  require_tools pacstrap genfstab mkinitcpio sgdisk

  require_tools cryptsetup sfdisk blkid lsblk

  if [[ ! -d /sys/firmware/efi ]] && (( ! ALLOW_BIOS )); then
    die "Machine is not booted in UEFI mode. (pass --allow-bios to continue anyway for testing)"
  fi
  if [[ ! -d /sys/firmware/efi ]] && (( ALLOW_BIOS )); then
    warn "BIOS-boot testing mode: EFI System Partition and limine UEFI deployment will not be usable."
  fi

  if [[ -z $DISK || ! -b $DISK ]]; then
    die "--disk must name a block device (got: ${DISK:-nothing})."
  fi

  if [[ -z $INSTALL_USER || $INSTALL_USER == "root" ]]; then
    die "--user must name the non-root user to create."
  fi

  if findmnt -rn -S "$DISK" >/dev/null 2>&1 || findmnt -rn -S "${DISK}2" >/dev/null 2>&1; then
    warn "Partitions on $DISK are mounted; they will be unmounted."
  fi

  # Never let an unattended or mis-typed flag wipe the very disk this live
  # media is running from.
  local live_root
  live_root=$(live_media_root_disk)
  if [[ -n $live_root && $DISK == "$live_root" ]]; then
    die "Refusing to erase $DISK: it is the disk the live media is running from."
  fi

  [[ -n $HOSTNAME ]] || HOSTNAME="magikos"

  if [[ -z $TIMEZONE ]] && command -v timedatectl >/dev/null 2>&1; then
    TIMEZONE=$(timedatectl show -p Timezone --value 2>/dev/null || true)
  fi
  [[ -n $TIMEZONE ]] || TIMEZONE="UTC"

  # Review-the-plan banner: re-state the whole intent so the wipe confirmation
  # that follows is a conscious last gate rather than a one-line reflex.
  printf '\n'
  log "Review the install plan for $DISK"
  printf '  Disk: %s\n' "$DISK"
  printf '  Hostname: %s\n' "$HOSTNAME"
  printf '  Timezone: %s\n' "$TIMEZONE"
  printf '  User: %s\n' "$INSTALL_USER"
  if (( ENCRYPT )); then
    printf '  Encryption: %s\n' "on"
  else
    printf '  Encryption: %s\n' "off"
  fi
  printf '\n'

  if ! ask_confirm "Erase ALL data on $DISK and install Magikos?"; then
    die "Aborted."
  fi
}

unmount_target() {
  # Restore any deferred boot-image hooks so an interrupted run never hands
  # back a system whose kernel packages silently skip rebuilding.
  unmask_target_boot_hooks
  run swapoff -a || true
  run umount -R "$TARGET" || run umount -lR "$TARGET" || true
  if (( ENCRYPT )); then
    run cryptsetup close "$LUKS_NAME" || true
  fi
}

partition_disk() {
  log "Partitioning $DISK"

  run swapoff -a || true
  local part mnt
  while read -r part; do
    while read -r mnt; do
      run umount -R "$mnt" || true
    done < <(findmnt -rn -S "$part" -o TARGET || true)
  done < <(lsblk -nrp -o NAME,TYPE "$DISK" | awk '$2 == "part" {print $1}')
  run wipefs -a "$DISK"

  # p1: EFI system partition. p2: everything else, optionally LUKS2 under it.
  run sgdisk -Z "$DISK"
  run sgdisk -n 1:0:+1G -t 1:ef00 -c 1:"ESP" "$DISK"
  run sgdisk -n 2:0:0 -t 2:8309 -c 2:"magikos-root" "$DISK"
  run partprobe "$DISK"

  # A disk-level wipefs cannot reach signatures inside partition offsets, so a
  # leftover header (e.g. after an aborted encrypted run) would survive and be
  # misidentified (mount: crypto_LUKS) or make luksFormat refuse --batch-mode.
  run wipefs -a "${DISK}1" || true
  run wipefs -a "${DISK}2" || true

  run mkfs.fat -F32 -n "MAGIKOS" "${DISK}1"

  if (( ENCRYPT )); then
    run cryptsetup luksFormat --type luks2 --batch-mode "${DISK}2"
    run cryptsetup open "${DISK}2" "$LUKS_NAME"
    ROOT_DEVICE="/dev/mapper/$LUKS_NAME"
  else
    ROOT_DEVICE="${DISK}2"
  fi

  run mkfs.btrfs -f -L "magikos" "$ROOT_DEVICE"

  # Subvolume layout: @ for root, @home for /home. Snapper watches @ (see
  # default/snapper/root) and Limine boots snapshots of it.
  run mount "$ROOT_DEVICE" "$TARGET"
  run btrfs subvolume create "$TARGET/@"
  run btrfs subvolume create "$TARGET/@home"
  run umount "$TARGET"

  local root_opts="noatime,compress=zstd:1,subvol=@"
  run mkdir -p "$TARGET"
  run mount -o "$root_opts" "$ROOT_DEVICE" "$TARGET"
  run mkdir -p "$TARGET/home" "$TARGET/boot"
  run mount -o "noatime,compress=zstd:1,subvol=@home" "$ROOT_DEVICE" "$TARGET/home"
  run mount "${DISK}1" "$TARGET/boot"

  if (( DRY_RUN )); then
    # Nothing was created, so there is nothing to probe. Placeholders keep
    # the run going into the config templates that consume the UUIDs.
    ROOT_UUID="00000000-0000-4000-8000-000000000001"
    LUKS_UUID=""
    if (( ENCRYPT )); then
      LUKS_UUID="00000000-0000-4000-8000-000000000002"
    fi
  else
    ROOT_UUID=$(blkid -s UUID -o value "$ROOT_DEVICE" || true)
    LUKS_UUID=$(blkid -s UUID -o value "${DISK}2" || true)
    if [[ -z $ROOT_UUID ]]; then
      die "Could not read the root filesystem UUID from $ROOT_DEVICE"
    fi
    if (( ENCRYPT )) && [[ -z $LUKS_UUID ]]; then
      die "Could not read the LUKS UUID from ${DISK}2"
    fi
  fi
}

seed_target_config() {
  log "Seeding target configuration"

  if [[ -d $ROOT/etc ]]; then
    sync_etc_dropins "$TARGET/etc"
  fi

  # The initramfs unlocks the root from /etc/crypttab.initramfs; the kernel
  # command line carries the LUKS UUID for the systemd initramfs generator.
  # limine-entry-tool sources the kernel parameters it writes into /boot/limine.conf
  # and embeds into UKIs from KERNEL_CMDLINE in /etc/default/limine, falling back
  # to /proc/cmdline. Inside an installer chroot the latter is the live medium's,
  # so the generated entries lose the root device unless we provide it here.
  local kernel_cmdline
  if (( ENCRYPT )); then
    write_file "$TARGET/etc/crypttab.initramfs" "$LUKS_NAME UUID=$LUKS_UUID none luks,discard"$'\n'
    write_file "$TARGET/etc/crypttab" "$LUKS_NAME UUID=$LUKS_UUID none luks,discard"$'\n'
    kernel_cmdline=$(printf 'root=UUID=%s rootflags=subvol=@ rw rd.luks.uuid=%s' "$ROOT_UUID" "$LUKS_UUID")
  else
    kernel_cmdline=$(printf 'root=UUID=%s rootflags=subvol=@ rw' "$ROOT_UUID")
  fi
  write_file "$TARGET/etc/kernel/cmdline" "$kernel_cmdline"$'\n'
  write_file "$TARGET/etc/default/limine" "\
ESP_PATH=\"/boot\"
KERNEL_CMDLINE[default]=\"$kernel_cmdline\"
BOOT_ORDER=\"linux-t2, linux-omarchy, linux-omarchy-*, *, *fallback, Snapshots\"
"

  write_file "$TARGET/etc/hostname" "$HOSTNAME"$'\n'
  write_file "$TARGET/etc/hosts" "$(cat <<EOF
127.0.0.1 localhost
::1 localhost
127.0.1.1 $HOSTNAME.localdomain $HOSTNAME
EOF
)"
  write_file "$TARGET/etc/locale.gen" "en_US.UTF-8 UTF-8"$'\n'
  write_file "$TARGET/etc/locale.conf" "LANG=en_US.UTF-8"$'\n'
  write_file "$TARGET/etc/timezone" "$TIMEZONE"$'\n'
  write_file "$TARGET/etc/sudoers.d/10-magikos-wheel" '%wheel ALL=(ALL:ALL) ALL'$'\n'
  if (( ! DRY_RUN )); then
    chmod 440 "$TARGET/etc/sudoers.d/10-magikos-wheel"
  fi
}

# The CachyOS admin signing key (used by the official bootstrap flow; the
# short id is what pacman-key matches for --recv-keys/--lsign-key).
CACHYOS_SIGNING_KEY="F3B607488DB35A47"

# Is the effective pacman already configured with the CachyOS repo? $1 is
# the pacman.conf to check ("" defaults to the live/host one).
cachyos_configured() {
  local conf="${1:-/etc/pacman.conf}"
  grep -qE '^\s*\[cachyos[[:space:]]*\]' "$conf" 2>/dev/null
}

# Does this machine have an NVIDIA GPU? The package set ships NVIDIA-only
# packages (proprietary driver stack, nvidia-open kernels, prime hybrid glue);
# on AMD/Intel systems those break the desktop, so they are only installed when
# a real NVIDIA Display/3D device is present on the PCI bus.
nvidia_present() {
  local dev cls ven
  for dev in /sys/bus/pci/devices/*; do
    [[ -r "$dev/class" ]] || continue
    cls=$(<"$dev/class")
    # 0x0300 VGA controller, 0x0302 3D controller, 0x0308 remote. The plain
    # display-controller class (0x0380, virtio-gpu/bochs) is not a GPU driver
    # target, so VMs stop here.
    case $cls in
      0x0300*|0x0302*|0x0308*) ;;
      *) continue ;;
    esac
    ven=$(<"$dev/vendor")
    if [[ $ven == 0x10de ]]; then
      return 0
    fi
  done
  return 1
}

# Should the installer add the CachyOS repos? Returns 0 when yes. $1 is the
# pacman.conf that matters for this run (the target's on fresh installs, the
# host's on adoption).
cachyos_wanted() {
  if (( CACHYOS_REPOS == 1 )); then
    return 0
  fi
  if (( CACHYOS_REPOS == 0 )); then
    return 1
  fi
  # Auto: add when the repos are missing from the effective configuration.
  cachyos_configured "$1" || return 0
  return 1
}

# Ask on the live media when the user did not pick a side. Defaults to yes:
# without the CachyOS repos a dozen package-set names (linux-cachyos, the
# cachyos-* settings/apps, the limine hooks) fall to slow AUR builds.
prompt_cachyos() {
  if (( CACHYOS_REPOS == 1 || CACHYOS_REPOS == 0 )); then
    return 0
  fi
  if (( ASSUME_YES )); then
    CACHYOS_REPOS=1
    return 0
  fi
  if [[ ! -t 0 ]]; then
    return 0
  fi
  if command -v gum >/dev/null 2>&1; then
    if gum confirm --default=true "Add the CachyOS repositories before installing packages?"; then
      CACHYOS_REPOS=1
    else
      CACHYOS_REPOS=0
    fi
  else
    local reply=""
    read -r -p "Add the CachyOS repositories before installing packages? [Y/n] " reply || reply=""
    if [[ $reply == n || $reply == N ]]; then
      CACHYOS_REPOS=0
    else
      CACHYOS_REPOS=1
    fi
  fi
}

# Curated from the cachyos-mirrorlist package so the paths match what the
# repo actually serves (repo/$arch/$repo). The package replaces this file
# with the current full list on its first install.
cachyos_mirrorlist() {
  cat <<'EOF'
Server = https://cdn77.cachyos.org/repo/$arch/$repo
Server = https://at.cachyos.org/repo/$arch/$repo
Server = https://us.cachyos.org/repo/$arch/$repo
Server = https://nl.mirror.cx/cachyos/repo/$arch/$repo
Server = https://ca.mirror.cx/cachyos/repo/$arch/$repo
Server = https://mirror.mergedcloud.de/cachyos/repo/$arch/$repo
Server = https://mirror.lesviallon.fr/cachy/repo/$arch/$repo
Server = https://mirror.zyner.org/mirror/cachyos/repo/$arch/$repo
EOF
}

# Trust the CachyOS signing key in $root ("" = live host, $TARGET = chroot).
# Returns 0 once the key is received and locally signed.
cachyos_trust_key() {
  local root="$1"
  local fetched=0

  # The live media's keyring may hold public keys but no secret one (archiso
  # defaults to a read-only root and never runs pacman-key --init), and
  # --lsign-key needs a secret key to sign with. gpg's exit code says nothing
  # about emptiness (list-secret-keys exits 0 with zero secret keys), so detect
  # by output: generate a master key when no "sec" line is listed.
  if [[ -z $root ]] && ! gpg --homedir /etc/pacman.d/gnupg \
      --list-secret-keys 2>/dev/null | grep -q '^sec'; then
    run pacman-key --init \
      || { warn "Could not initialize the live media keyring."; return 1; }
  fi
  # The target may have bootstrapped with a yes-flooded -K whose master-key
  # generation got interrupted, leaving the keyring without a secret either.
  # The check must run INSIDE the chroot: pacstrap initializes the keyring
  # with a gpg-agent that dies with pacstrap's private mount namespace, and a
  # host-side gpg can disagree with the chroot's gpg about what secrets are
  # available (the host often sees the key while the fresh chroot agent does
  # not). Initialize in the chroot's own gpg context when it sees no secret.
  if [[ -n $root ]] && ! chroot_exec "gpg --homedir /etc/pacman.d/gnupg \
      --list-secret-keys 2>/dev/null | grep -q '^sec'"; then
    chroot_exec "gpgconf --kill gpg-agent 2>/dev/null || true; pacman-key --init" \
      || { warn "Could not initialize the target keyring."; return 1; }
  fi

  # Preferred path: the ISO bundles cachyos-keyring.pkg.tar.zst at
  # /root/cachyos-keyring.pkg.tar.zst (see iso/build.sh). Import its keyring
  # into the target's pacman keyring and lsign the signing key: no public
  # keyserver traffic, so it works offline or behind NATs where gpg/dirmngr
  # keyserver lookups fail (qemu slirp).
  local bundle=/root/cachyos-keyring.pkg.tar.zst
  if [[ -f $bundle ]]; then
    local keyring_dir
    keyring_dir=$(mktemp -d)
    if tar --zstd -xOf "$bundle" \
        usr/share/pacman/keyrings/cachyos.gpg > "$keyring_dir/cachyos.gpg" 2>/dev/null; then
      if [[ -z $root ]]; then
        if run pacman-key --add "$keyring_dir/cachyos.gpg" \
            && run pacman-key --lsign-key "$CACHYOS_SIGNING_KEY"; then
          fetched=1
        fi
      else
        cp "$keyring_dir/cachyos.gpg" "$root/tmp/cachyos-keyring.gpg"
        # Run both steps in one chroot session: the gpg-agent the --add step
        # spawns would otherwise be gone (separate chroot_ex call), and
        # --lsign-key needs that agent context to see the secret master key.
        if chroot_exec "gpgconf --kill gpg-agent 2>/dev/null || true; \
            pacman-key --add /tmp/cachyos-keyring.gpg \
            && pacman-key --lsign-key $CACHYOS_SIGNING_KEY"; then
          fetched=1
          rm -f "$root/tmp/cachyos-keyring.gpg"
        fi
      fi
    fi
    rm -rf "$keyring_dir"
  fi
  if ((fetched)); then
    return 0
  fi

  # Fallback: several public keyservers (hkps uses 443 which works under slirp).
  if ! ((fetched)); then
    local endpoints=(
      "hkps://keys.cachyos.org"
      "keyserver.ubuntu.com"
      "hkps://keyserver.ubuntu.com"
      "keys.openpgp.org"
    )
    local ep attempt got=0
    if [[ -z $root ]]; then
      for attempt in 1 2; do
        for ep in "${endpoints[@]}"; do
          if run pacman-key --recv-keys "$CACHYOS_SIGNING_KEY" --keyserver "$ep"; then
            got=1
            break 2
          fi
        done
      done
      if ((got)); then
        run pacman-key --lsign-key "$CACHYOS_SIGNING_KEY" || return 1
      fi
      ((got))
    else
      for attempt in 1 2; do
        for ep in "${endpoints[@]}"; do
          if chroot_exec "pacman-key --recv-keys $CACHYOS_SIGNING_KEY --keyserver $ep"; then
            got=1
            break 2
          fi
        done
      done
      if ((got)); then
        chroot_exec "pacman-key --lsign-key $CACHYOS_SIGNING_KEY" || return 1
      fi
      ((got))
    fi
  fi
}

# Enable the [multilib] repo in "$root"/etc/pacman.conf ("" = live host, $TARGET
# = chroot). The Magikos package set carries lib32-gamemode and friends, and the
# CachyOS gaming stack pulls lib32-* vulkan/mesa dependencies, all of which only
# resolve from [multilib]. The stock conf ships that section commented out, so
# the batch would otherwise fail with "unable to satisfy dependency 'lib32-*'".
# pacstrap resolves transactions against a snapshot of the LIVE media's
# /etc/pacman.conf, so the section must be enabled there too, not just in the
# target.
enable_multilib() {
  local root="$1"
  local conf="$root/etc/pacman.conf"
  [[ -f $conf ]] || return 0
  if ! grep -qE '^\s*\[multilib[[:space:]]*\]' "$conf"; then
    run cp "$conf" "$conf.magikos-bak"
    # Uncomment the [multilib] section header and its following Include line
    # (and only those two lines, so any sibling comment can never be stripped).
    run sed -i 's/^#[[:space:]]*\(\[multilib[[:space:]]*\]\)$/\1/' "$conf"
    if grep -A1 '^\s*\[multilib[[:space:]]*\]' "$conf" | grep -qE '^\s*#\s*Include'; then
      run sed -i '/^\s*\[multilib[[:space:]]*\]$/{n;s/^#[[:space:]]*//;}' "$conf"
    fi
    if grep -A1 '^\s*\[multilib[[:space:]]*\]' "$conf" | grep -q '^Include'; then
      :
    else
      write_file "$conf" "$(sed '/^\s*\[multilib[[:space:]]*\]/a\
Include = /etc/pacman.d/mirrorlist' "$conf")"
    fi
  fi
  # Mirror into the live media's conf too so the pacstrap transaction (which
  # runs from a snapshot of /etc/pacman.conf) can resolve lib32 dependencies.
  if [[ -n $root && -f /etc/pacman.conf ]] \
      && ! grep -qE '^\s*\[multilib[[:space:]]*\]' /etc/pacman.conf; then
    run cp /etc/pacman.conf /etc/pacman.conf.magikos-bak
    run sed -i 's/^#[[:space:]]*\(\[multilib[[:space:]]*\]\)$/\1/' /etc/pacman.conf
    if grep -A1 '^\s*\[multilib[[:space:]]*\]' /etc/pacman.conf | grep -qE '^\s*#\s*Include'; then
      run sed -i '/^\s*\[multilib[[:space:]]*\]$/{n;s/^#[[:space:]]*//;}' /etc/pacman.conf
    fi
    if grep -A1 '^\s*\[multilib[[:space:]]*\]' /etc/pacman.conf | grep -q '^Include'; then
      :
    else
      write_file /etc/pacman.conf "$(sed '/^\s*\[multilib[[:space:]]*\]/a\
Include = /etc/pacman.d/mirrorlist' /etc/pacman.conf)"
    fi
  fi
}

# Add the [omarchy] repo to "$root"/etc/pacman.conf ("" = live host, $TARGET
# = chroot). The package set's preferred kernel (linux-omarchy, and its
# headers) exists only there while pkgs.magikos.org is not live yet, so
# without this section the kernel lands in the failure report on every fresh
# system. SigLevel is Optional TrustAll, exactly as the section shipped
# before the Magikos rename, so no key import is needed. On fresh installs
# the section is mirrored into the LIVE conf as well: pacstrap resolves
# transactions against a snapshot of that file (the same reason the
# [cachyos] section is mirrored).
enable_omarchy_repo() {
  local root="$1"
  local conf="$root/etc/pacman.conf"
  local section=$'[omarchy]\nSigLevel = Optional TrustAll\nServer = https://pkgs.omarchy.org/stable/$arch'
  local host_added=0 target_added=0

  if [[ -f $conf ]] && ! grep -qE '^\s*\[omarchy[[:space:]]*\]' "$conf"; then
    log "Adding the [omarchy] repository (linux-omarchy kernel)"
    run cp "$conf" "$conf.magikos-bak"
    write_file "$conf" "$(cat "$conf")"$'\n'"$section"$'\n'
    if [[ -z $root ]]; then host_added=1; else target_added=1; fi
  fi

  if [[ -n $root && -f /etc/pacman.conf ]] && ! grep -qE '^\s*\[omarchy[[:space:]]*\]' /etc/pacman.conf; then
    run cp /etc/pacman.conf /etc/pacman.conf.magikos-bak
    write_file /etc/pacman.conf "$(cat /etc/pacman.conf)"$'\n'"$section"$'\n'
    host_added=1
  fi

  if (( host_added )); then
    run pacman -Sy --noconfirm || warn "Could not sync the package databases after adding [omarchy]."
  fi
  if (( target_added )); then
    chroot_exec "pacman -Sy --noconfirm" || warn "Could not sync the target databases after adding [omarchy]."
  fi
}

# Add the [cachyos] repo ("$root"/etc/pacman.conf, mirrorlist, keyring, sync).
# $1 is "" for the live host or $TARGET for a fresh-install chroot. Returns
# nonzero (without touching pacman.conf) when key trust cannot be established,
# so a broken fetch can never leave an untrusted repo blocking every -S.
enable_cachyos_repos() {
  local root="$1"
  local conf="$root/etc/pacman.conf"

  log "Adding the CachyOS repositories"

  # pacstrap leaves no resolv.conf behind in the target; chroot network ops
  # (keyring fetch, keyserver, the repo syncs) need one, so copy the live
  # media's when the target has none.
  if [[ -n $root && ! -e "$root/etc/resolv.conf" && -r /etc/resolv.conf ]]; then
    run cp /etc/resolv.conf "$root/etc/resolv.conf"
  fi

  if ! cachyos_trust_key "$root"; then
    warn "Could not establish CachyOS key trust; leaving repositories unchanged."
    return 1
  fi

  if [[ -f $conf ]]; then
    if grep -qE '^\s*\[cachyos[[:space:]]*\]' "$conf"; then
      :
    elif grep -q '^\[core\]' "$conf"; then
      # The repos must precede Arch's so CachyOS-provided packages win;
      # the sed inserts both lines directly above [core].
      run cp "$conf" "$conf.magikos-bak"
      run sed -i \
        -e '/^\[core\]/i # CachyOS repos (added by the Magikos installer; backup: '"$(basename "$conf")"$'.magikos-bak)' \
        -e '/^\[core\]/i [cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist' \
        "$conf"
    else
      run cp "$conf" "$conf.magikos-bak"
      write_file "$conf" "$(cat "$conf")"$'\n[cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n'
    fi
  fi

  write_file "$root/etc/pacman.d/cachyos-mirrorlist" "$(cachyos_mirrorlist)"

  # pacstrap runs pacman against a snapshot of the LIVE /etc/pacman.conf and,
  # on success, overwrites the target's conf with it. Unless the live media
  # resolves [cachyos] too, pacstrap cannot see CachyOS packages and the whole
  # batch aborts with "target not found". Mirror the repo into the live env.
  if [[ -n $root ]] && [[ -f /etc/pacman.conf ]]; then
    if ! grep -qE '^\s*\[cachyos[[:space:]]*\]' /etc/pacman.conf; then
      if grep -q '^\[core\]' /etc/pacman.conf; then
        run sed -i \
          -e '/^\[core\]/i # CachyOS repos (added by the Magikos installer)' \
          -e '/^\[core\]/i [cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist' \
          /etc/pacman.conf
      else
        write_file /etc/pacman.conf "$(cat /etc/pacman.conf)"$'\n[cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n'
      fi
    fi
    mkdir -p /etc/pacman.d
    write_file /etc/pacman.d/cachyos-mirrorlist "$(cachyos_mirrorlist)"

    # pacstrap validates the cachyos database and package signatures against
    # the LIVE MEDIA's own keyring (not the target's), so mirroring the repo
    # config is not enough: the CachyOS admin key must also be trusted in the
    # host keyring or every pacstrap batch aborts with "signature is unknown
    # trust". The target chroot keyring was already handled by cachyos_trust_key.
    cachyos_trust_key "" \
      || warn "Could not trust the CachyOS key in the live media keyring; the pacstrap batches may fail."
  fi

  # Pull the keyring/mirrorlist packages from the repo itself so signatures
  # and mirrorlist stay exactly what CachyOS ships.
  if [[ -z $root ]]; then
    # --ask=4 answers the "remove conflicting package?" prompt (yes), so a
    # stale legacy package like chwd-db cannot abort a --noconfirm batch.
    run pacman -Sy --ask=4 --noconfirm --needed cachyos-keyring cachyos-mirrorlist \
      || warn "Could not install the CachyOS keyring package."
    run pacman-key --populate archlinux cachyos || warn "Could not populate the CachyOS keyring."
  else
    if chroot_exec "pacman -Sy --ask=4 --noconfirm --needed cachyos-keyring cachyos-mirrorlist"; then
      :
    else
      chroot_exec "pacman -Syy --ask=4 --noconfirm --needed cachyos-keyring cachyos-mirrorlist" \
        || warn "Could not install the CachyOS keyring package in the target."
    fi
    chroot_exec "pacman-key --populate cachyos" || warn "Could not populate the CachyOS keyring in the target."
  fi
}

# Names in $@ that the TARGET's pacman databases can actually resolve. The
# target's repo list is authoritative: the live media may carry CachyOS repos
# the target has not been configured with (and vice versa after --cachyos-repos),
# so feeding pacstrap a name it cannot find would abort the whole batch.
packages_resolvable_in_target() {
  local name
  local -A in_repo=()
  if (( DRY_RUN )); then
    printf '[dry-run] resolve %d package name(s) against the target repository list\n' "$#"
    return 0
  fi
  while read -r name; do
    [[ -n $name ]] && in_repo[$name]=1
  done < <(chroot "$TARGET" /bin/bash -lc 'pacman -Slq' 2>/dev/null | sort -u)
  for name in "$@"; do
    if [[ ${in_repo[$name]+set} ]]; then
      printf '%s\n' "$name"
    fi
  done
}

bootstrap_arch() {
  log "Bootstrapping Arch base system (pacstrap)"

  # One-time package database sync for the live media so all subsequent
  # pacstrap / pacman calls see fresh databases without repeating the sync.
  run pacman -Sy --noconfirm --ask=1 >/dev/null

  # Limine goes in with the kernel so the mkinitcpio hook deploys the UKI in
  # the same transaction. limine-mkinitcpio-hook and limine-snapper-sync are
  # not in the repos on vanilla Arch media, so split the base set exactly like
  # the Magikos set: only names the active repos resolve go into the atomic
  # batch, and anything else defers to the yay pass. A single unknown name
  # would otherwise abort the whole batch and force a slow per-package loop
  # over every base package. finalize_limine_boot re-runs mkinitcpio -P after
  # the AUR pass, so it sees any hooks that were deferred.
  local base_pkgs=(
    base base-devel linux linux-firmware linux-headers \
    btrfs-progs dosfstools e2fsprogs sudo git \
    limine limine-mkinitcpio-hook limine-snapper-sync snapper \
    networkmanager sddm sway uwsm foot polkit gnome-keyring \
    pipewire wireplumber plymouth ufw gum rsync jq openssh
  )
  local -A in_base_repo=()
  local name
  while read -r name; do
    [[ -n $name ]] && in_base_repo[$name]=1
  done < <(pacman -Slq 2>/dev/null | sort -u)
  local BASE_REPO=() BASE_AUR=() pkg
  for pkg in "${base_pkgs[@]}"; do
    if [[ ${in_base_repo[$pkg]+set} ]]; then
      BASE_REPO+=("$pkg")
    else
      BASE_AUR+=("$pkg")
    fi
  done
  if ((${#BASE_REPO[@]} == 0)); then
    # Self-contained ISOs bundle the repo under /run/archiso/bootmnt/arch;
    # when no local repo is present base is unresolvable offline, so fall back
    # to syncing the live media's package DBs over the network.
    warn "No packages resolve from the live media repos; syncing package DBs (network)."
    if ! run pacman -Sy --noconfirm --ask=1; then
      die "Could not resolve base packages from the live media or a synced package DB."
    fi
    in_base_repo=()
    while read -r name; do
      [[ -n $name ]] && in_base_repo[$name]=1
    done < <(pacman -Slq 2>/dev/null | sort -u)
    BASE_REPO=() BASE_AUR=()
    for pkg in "${base_pkgs[@]}"; do
      if [[ ${in_base_repo[$pkg]+set} ]]; then
        BASE_REPO+=("$pkg")
      else
        BASE_AUR+=("$pkg")
      fi
    done
  fi
  if ((${#BASE_REPO[@]} == 0)); then
    die "No base packages resolve from the live media repos."
  fi
  # The base set cannot trigger the limine-mkinitcpio-hook prompt (that hook is
  # AUR-only and gets deferred), so keep it plain: the one yes-flooded -K
  # bootstrap run failed the whole batch right after its transaction hooks
  # completed, which plain -K runs never did.
  if ! run pacstrap -K "$TARGET" "${BASE_REPO[@]}" --ask=1 --overwrite '*'; then
    warn "Base batch install failed; falling back to per-package installs."
    local pkg
    for pkg in "${BASE_REPO[@]}"; do
      if (( DRY_RUN )); then
        printf '[dry-run] pacstrap -K %s: %s\n' "$TARGET" "$pkg"
      elif ! pacstrap -K "$TARGET" "$pkg" --ask=1 --overwrite '*' >>"$LOG_FILE" 2>&1; then
        PKG_FAILURES+=("$pkg")
      fi
    done
  fi
  if ((${#BASE_AUR[@]} > 0)); then
    warn "Deferring AUR-only base package(s) temporarily: ${BASE_AUR[*]}"
  fi

  # Scriptlets, pacman-key, and chroot_exec need the virtual kernels inside
  # the target; pacstrap's own mounts live in a private namespace and vanish
  # with it.
  run mount --rbind /dev "$TARGET/dev"
  run mount --make-rslave "$TARGET/dev"
  run mount -t proc /proc "$TARGET/proc"
  run mount --rbind /sys "$TARGET/sys"
  run mount --make-rslave "$TARGET/sys"
  run mount --rbind /run "$TARGET/run"
  run mount --make-rslave "$TARGET/run"

  # Give the target the CachyOS repos before any Magikos package resolution:
  # the package set carries CachyOS-only names (linux-cachyos, the cachyos-*
  # settings/apps, the limine hooks) that must resolve as binaries instead of
  # being compiled from the AUR.
  enable_multilib "$TARGET"
  enable_omarchy_repo "$TARGET"
  if cachyos_wanted "$TARGET/etc/pacman.conf"; then
    enable_cachyos_repos "$TARGET" \
      || warn "Continuing without the CachyOS repositories."
  fi

  # Names the base batch could not resolve on the live media may be available
  # in the target now that CachyOS is configured (limine-mkinitcpio-hook,
  # limine-snapper-sync). Install what the target resolves; only the truly
  # missing ones fall to the yay pass.
  local base_resolvable=() base_missing=() pkg
  for pkg in "${BASE_AUR[@]}"; do
    if [[ $(packages_resolvable_in_target "$pkg") == "$pkg" ]]; then
      base_resolvable+=("$pkg")
    else
      base_missing+=("$pkg")
    fi
  done
  if ((${#base_resolvable[@]} > 0)); then
    log "Installing deferred base packages from the target repos"
    if (( DRY_RUN )); then
      printf '[dry-run] pacstrap %s: %s\n' "$TARGET" "${base_resolvable[*]}"
    elif ! pacstrap_yes "$TARGET" "${base_resolvable[@]}"; then
      warn "Base follow-up batch failed; falling back per-package."
      for pkg in "${base_resolvable[@]}"; do
        pacstrap_yes "$TARGET" "$pkg" >>"$LOG_FILE" 2>&1 || PKG_FAILURES+=("$pkg")
      done
    fi
  fi
  if ((${#base_missing[@]} > 0)); then
    warn "Deferring AUR-only base package(s) to the yay pass: ${base_missing[*]}"
    PKG_FAILURES+=("${base_missing[@]}")
  fi

  log "Installing Magikos package set (best effort)"

  mapfile -t packages < <(grep -v '^#' "$ROOT/install/magikos-base.packages" | grep -v '^$')
  if (( ${#packages[@]} == 0 )); then
    die "No packages found in install/magikos-base.packages"
  fi

  # NVIDIA-only packages are opt-in per hardware; drop them from the set when
  # no NVIDIA GPU is present so they cannot be pulled in by the yay pass.
  if ! nvidia_present; then
    # shellcheck disable=SC2207
    mapfile -t packages < <(printf '%s\n' "${packages[@]}" | grep -vi 'nvidia')
  fi

  # Split against the target's own repo list, so the batch never contains a
  # name pacstrap cannot resolve (that would abort the whole transaction).
  local -A in_magikos_repo=()
  local name
  local -a magikos_resolvable=()
  mapfile -t magikos_resolvable < <(packages_resolvable_in_target "${packages[@]}")
  for name in "${magikos_resolvable[@]}"; do
    in_magikos_repo[$name]=1
  done
  PACKAGE_REPO=()
  for pkg in "${packages[@]}"; do
    if [[ ${in_magikos_repo[$pkg]+set} ]]; then
      PACKAGE_REPO+=("$pkg")
    else
      PKG_FAILURES+=("$pkg")
    fi
  done
  if (( ${#PACKAGE_REPO[@]} == 0 )); then
    return 0
  fi
  if ! run pacstrap_yes "$TARGET" "${PACKAGE_REPO[@]}"; then
    warn "Batch install failed for ${#PACKAGE_REPO[@]} repo package(s); retrying per-package."
    for pkg in "${PACKAGE_REPO[@]}"; do
      if (( DRY_RUN )); then
        printf '[dry-run] pacstrap %s: %s\n' "$TARGET" "$pkg"
      elif ! pacstrap_yes "$TARGET" "$pkg" >>"$LOG_FILE" 2>&1; then
        PKG_FAILURES+=("$pkg")
      fi
    done
  fi
}


# Replicates the magikos-settings package assembly of /etc/skel, which does
# not exist as a package yet: config/** maps under .config, default/bashrc
# becomes the dotfile, and shipped desktop entries land in .local/share.
assemble_skeleton() {
  local skel="$1"
  run mkdir -p "$skel/.config" "$skel/.local/share/applications" "$skel/Pictures/Wallpapers"
  run cp -a "$ROOT/config/." "$skel/.config/"
  run cp -a "$ROOT/default/bashrc" "$skel/.bashrc"
  if [[ -d $ROOT/applications ]]; then
    run cp -a "$ROOT/applications/." "$skel/.local/share/applications/"
  fi
  # Ship default wallpapers so the sway config (output * bg ~/Pictures/Wallpapers/Osaka.jpg) works immediately
  if [[ -d $ROOT/wallpapers ]]; then
    run cp -a "$ROOT/wallpapers/." "$skel/Pictures/Wallpapers/"
  fi
  # Magikos always launches the shell with an explicit path, but a bare
  # `quickshell` should still find it; point the default config at the tree.
  run mkdir -p "$skel/.config/quickshell"
  run ln -sfn "$PLANTED/shell" "$skel/.config/quickshell/default"
}

install_app_icons() {
  # applications/icons are single-size PNGs; hicolor wants them under the
  # standard size dirs so desktop lookups resolve.
  local prefix="$1" size
  if [[ ! -d $ROOT/applications/icons ]]; then
    return 0
  fi
  for size in 48x48 256x256; do
    run mkdir -p "$prefix/usr/share/icons/hicolor/$size/apps"
    run cp -a "$ROOT/applications/icons/." "$prefix/usr/share/icons/hicolor/$size/apps/"
  done
}

# System files the magikos-settings package would own on a packaged install.
# The installer plants the tree instead of installing that package, so it
# must recreate these destinations itself — fonts, fontconfig rules, user
# units, mimeapps, and the snapper template all live under default/.
plant_package_owned_files() {
  local prefix="$1"
  run install -Dm644 "$ROOT/default/fonts/magikos/magikos.ttf" \
    "$prefix/usr/share/fonts/magikos/magikos.ttf"
  run install -Dm644 "$ROOT/default/fontconfig/conf.avail/50-magikos.conf" \
    "$prefix/usr/share/fontconfig/conf.avail/50-magikos.conf"
  run mkdir -p "$prefix/etc/fonts/conf.d"
  run ln -sfn /usr/share/fontconfig/conf.avail/50-magikos.conf \
    "$prefix/etc/fonts/conf.d/50-magikos.conf"
  run install -Dm644 "$ROOT/default/applications/mimeapps.list" \
    "$prefix/usr/share/applications/mimeapps.list"
  if [[ -d $ROOT/default/systemd/user ]]; then
    run mkdir -p "$prefix/usr/lib/systemd/user"
    run cp -a "$ROOT/default/systemd/user/." "$prefix/usr/lib/systemd/user/"
  fi
  if [[ -d $ROOT/default/systemd/zram-generator.conf.d ]]; then
    run mkdir -p "$prefix/usr/lib/systemd/zram-generator.conf.d"
    run cp -a "$ROOT/default/systemd/zram-generator.conf.d/." \
      "$prefix/usr/lib/systemd/zram-generator.conf.d/"
  fi
  run mkdir -p "$prefix/etc/snapper/config-templates"
  run cp -a "$ROOT/default/snapper/root" \
    "$prefix/etc/snapper/config-templates/magikos"
}

# System drop-ins we own outright.
# pacstrap's pacman runs post-transaction hooks; limine-mkinitcpio's asks "run
# limine-mkinitcpio now? [Y/n]" on /dev/tty even under --noconfirm, blocking an
# unattended install forever. Feeding a flood of "yes" pre-answers every hooks
# prompt (pipefail keeps the real pacstrap exit status).
pacstrap_yes() {
  # --ask=1 answers provider selection; add --overwrite '*' to resolve
  # conflicts like zlib-ng-compat vs zlib without prompting.
  pacstrap "$@" --ask=1 --overwrite '*'
}

sync_etc_dropins() {
  local dest="$1"
  # --chown matters: the checkout files are owned by the invoking user, and
  # sudo refuses /etc/sudoers.d entries that are not owned by root.
  run rsync -a --chown=root:root "$ROOT/etc/" "$dest/"
  # Force the canonical sudoers mode too; the checkout carries user umask bits.
  if [[ -d $dest/sudoers.d ]]; then
    run find "$dest/sudoers.d" -type f -exec chmod 440 {} +
  fi
}

# Autologin at the login screen is opt-in (default off, matching the stock
# Magikos SDDM password login). The tree ships no autologin drop-in, so a
# default install gets the password prompt; only --autologin writes one, and
# adopting an existing system clears any drop-in the previous setup left behind
# unless the flag was passed.
seed_autologin() {
  local dest="$1" user="$2"
  if (( AUTOLOGIN )); then
    write_file "$dest/sddm.conf.d/autologin.conf" \
      "$(cat <<EOF
[Autologin]
User=$user
Session=sway
EOF
)"$'\n'
  else
    run rm -f "$dest/sddm.conf.d/autologin.conf"
  fi
}

# The planted tree is the only source of magikos-* commands on an
# installer-built system (the magikos package that normally ships them into
# /usr/bin is not installed here). Expose every command through /usr/local/bin,
# which precedes /usr/bin on PATH and is visible to every session context:
# terminals, systemd units, SSH, and the shell itself. Non-executable sourced
# libraries (e.g. magikos-pkg-backend) live in bin/ too and must be reachable
# on PATH just like the executables that source them.
link_planted_binaries() {
  local tree="$1" prefix="$2"
  local exe name bindir="$prefix/usr/local/bin"
  run mkdir -p "$bindir"
  # Enumerate from the checkout: it is exactly what plant_* rsyncs into
  # $tree, which may not exist yet under --dry-run.
  for exe in "$ROOT/bin/"*; do
    [[ -f $exe ]] || continue
    name=${exe##*/}
    run ln -sfn "$tree/bin/$name" "$bindir/$name"
  done
}

plant_magikos() {
  log "Planting the Magikos tree at /usr/share/magikos"

  run mkdir -p "$TARGET/usr/share/magikos"
  run rsync -a --delete --chown=root:root \
    --exclude '.git/' --exclude 'test/' --exclude '*.log' \
    "$ROOT/" "$TARGET/usr/share/magikos/"

  # Shipped user defaults are seeded through /etc/skel, which useradd copies
  # at account creation (normally the magikos-settings package does this).
  run mkdir -p "$TARGET/etc/skel"
  assemble_skeleton "$TARGET/etc/skel"
  install_app_icons "$TARGET"

  link_planted_binaries "$TARGET/usr/share/magikos" "$TARGET"

  # uwsm sources /usr/share/uwsm/env.d/* for the graphical session; the
  # packaged install ships this file, so recreate it here.
  run install -Dm644 "$ROOT/default/uwsm/env.d/10-magikos" \
    "$TARGET/usr/share/uwsm/env.d/10-magikos"

  # systemd-environment-d-generator reads /usr/lib/environment.d/*.conf for
  # the user session; the magikos-settings package post_install copies these.
  run mkdir -p "$TARGET/usr/lib/environment.d"
  run cp -a "$ROOT/default/environment.d/." "$TARGET/usr/lib/environment.d/"

  plant_package_owned_files "$TARGET"
}

configure_target() {
  log "Configuring locale, clock, and fstab"

  chroot_exec "locale-gen"
  chroot_exec "ln -sf /usr/share/zoneinfo/$(printf '%q' "$TIMEZONE") /etc/localtime"
  chroot_exec "hwclock --systohc"

  # Written by hand rather than genfstab.
  local esp_uuid root_opts home_opts fstab
  if (( DRY_RUN )); then
    esp_uuid="00000000-0000-4000-8000-000000000003"
  else
    esp_uuid=$(blkid -s UUID -o value "${DISK}1" || true)
  fi
  root_opts="noatime,compress=zstd:1,subvol=@"
  home_opts="noatime,compress=zstd:1,subvol=@home"

  fstab=$(cat <<EOF
UUID=$esp_uuid  /boot       vfat    rw,umask=0077   0 2
UUID=$ROOT_UUID /           btrfs   $root_opts      0 0
UUID=$ROOT_UUID /home       btrfs   $home_opts      0 0
tmpfs           /tmp        tmpfs   rw,noatime      0 0
EOF
)
  write_file "$TARGET/etc/fstab" "$fstab"$'\n'
}

# --- Boot-image hook masking -----------------------------------------------
# The package phases (pacstrap, yay, magikos-apply-system's chrooted pacman)
# each trigger limine-mkinitcpio-hook, rebuilding UKIs and limine.conf many
# times mid-install against a cmdline/fstab that are still changing. Exactly
# as in the omarchy orchestrator, those rebuilds are deferred: mask the
# boot-image hooks for every package phase, then run limine-update once at
# finalize_limine_boot when every drop-in (hibernation, hardware, autologin)
# is in place. The masks are symlink swaps to /dev/null in both hook dirs
# alpm reads, restored on the way out -- including on the unmount EXIT trap,
# so an interrupted install never hands back a masked system.

TARGET_DEFERRED_BOOT_HOOKS=(
  "60-mkinitcpio-remove.hook"
  "60-limine-mkinitcpio-remove-pre.hook"
  "80-limine-efi-deploy.hook"
  "90-limine-mkinitcpio-remove-post.hook"
  "90-mkinitcpio-install.hook"
  "90-limine-mkinitcpio.hook"
)

_is_devnull_symlink() {
  [[ -L $1 ]] && [[ $(readlink -- "$1") == "/dev/null" ]]
}

mask_target_boot_hooks() {
  (( DRY_RUN )) && return 0
  local dir name from backup
  for dir in "$TARGET/etc/pacman.d/hooks" "$TARGET/usr/share/libalpm/hooks"; do
    [[ -d $dir ]] || continue
    for name in "${TARGET_DEFERRED_BOOT_HOOKS[@]}"; do
      from="$dir/$name"
      [[ -e $from || -L $from ]] || continue
      _is_devnull_symlink "$from" && continue
      backup="$from.magikos-backup"
      rm -f -- "$backup"
      mv -- "$from" "$backup"
      ln -s /dev/null "$from"
      TARGET_HOOK_MASKS+=("$from")
    done
  done
}

unmask_target_boot_hooks() {
  (( DRY_RUN )) && return 0
  local from backup
  for from in "${TARGET_HOOK_MASKS[@]:-}"; do
    backup="$from.magikos-backup"
    _is_devnull_symlink "$from" && rm -f -- "$from"
    [[ -e $backup || -L $backup ]] && mv -f -- "$backup" "$from"
  done
  TARGET_HOOK_MASKS=()
}

assert_boot_hooks_restored() {
  local dir name from
  for dir in "$TARGET/etc/pacman.d/hooks" "$TARGET/usr/share/libalpm/hooks"; do
    [[ -d $dir ]] || continue
    for name in "${TARGET_DEFERRED_BOOT_HOOKS[@]}"; do
      from="$dir/$name"
      backup="$from.magikos-backup"
      if _is_devnull_symlink "$from"; then
        die "boot hook still masked: $from"
      fi
      if [[ -e $backup || -L $backup ]]; then
        die "boot hook backup left behind: $backup"
      fi
    done
  done
}

# Register MagikOS as the UEFI boot entry on the ESP, from the live side so
# efibootmgr talks to the running firmware (the same machine the target will
# boot on). Replaces the earlier limine-entry-tool --add-efi sandwhich, which
# was a silent no-op: inside the chroot the tool wants the OS-mount path, and
# the hooks already copied the loader -- but nothing verifiably created a
# boot entry. Delete stale MagikOS/Limine entries, create a fresh one
# pointed at the real loader, and put it first in the boot order.
register_uefi_entry() {
  (( DRY_RUN )) && return 0
  [[ -d /sys/firmware/efi ]] || {
    warn "not UEFI; skipping UEFI boot-entry registration."
    return 0
  }
  command -v efibootmgr >/dev/null 2>&1 || {
    warn "efibootmgr is not on the live media; skipping UEFI boot-entry registration."
    return 0
  }

  local loader="\\EFI\\limine\\limine_x64.efi"

  # efibootmgr lists entries as "Boot0009* Limine x64": $1 is "Boot0009*".
  # Pull the numeric boot number out (hex digits only) so --bootnum can
  # address it later, dropping both the "Boot" tag and the active "*".
  local bootnums num
  bootnums() {
    efibootmgr 2>/dev/null | sed -nE 's/^Boot([0-9A-F]+)[* ] .*/\1/p'
  }
  for num in $(bootnums); do
    case "$(efibootmgr 2>/dev/null | grep -iE "Boot${num}[* ] " |
        sed -nE 's/^Boot[0-9A-F]+[* ] //p')" in
      MagikOS*|Limine*) efibootmgr --bootnum "$num" --delete-bootnum >/dev/null 2>&1 || true ;;
    esac
  done

  if efibootmgr --create --disk "${DISK}" --part 1 --label "MagikOS" \
      --loader "$loader" --unicode; then
    log "Registered UEFI boot entry 'MagikOS'"
  else
    warn "efibootmgr --create failed; the ESP fallback (if any) or firmware boot menu must select the loader."
    return 0
  fi

  local new_num
  new_num=$(grep -iE 'MagikOS|Limine' <(efibootmgr 2>/dev/null) | sed -nE 's/^Boot([0-9A-F]+)[* ] MagikOS.*/\1/p' | head -1)
  local order current left
  if [[ -n $new_num ]]; then
    current=$(efibootmgr 2>/dev/null | sed -n 's/^BootOrder: //p')
    order="$new_num"
    for left in ${current//,/}; do
      [[ $left == "$new_num" ]] && continue
      order="$order,$left"
    done
    efibootmgr --bootorder "$order" >/dev/null 2>&1 || true
  fi
}

finalize_limine_boot() {
  log "Rebuilding UKIs and deploying Limine (single final build)"

  # All package phases are done; the cmdline, fstab, snapper limits, and any
  # system-finalizer drop-ins are final. Unmask the boot hooks and build once.
  unmask_target_boot_hooks
  assert_boot_hooks_restored

  chroot_exec "mkinitcpio -P" || { unmask_target_boot_hooks; die "initramfs rebuild failed"; }

  if chroot_exec "command -v limine-update" >/dev/null 2>&1; then
    # limine-update runs limine-install --no-efi-register (which deploys the
    # limine loader and the ESP fallback copy) followed by limine-mkinitcpio
    # (which rebuilds UKIs and regenerates limine.conf).
    chroot_exec "limine-update" || {
      unmask_target_boot_hooks
      die "limine-update failed; verify the ESP has a bootloader before rebooting."
    }
  else
    unmask_target_boot_hooks
    die "limine-update is not present; verify the ESP has a bootloader."
  fi

  # The menu tool generates /boot/limine.conf from the installer chroot, where
  # its root-device detection can resolve to nothing. Normalize every generated
  # kernel command line carrying no root device to the target's own parameters
  # so the installed kernels always boot from the right disk.
  local cmdline
  cmdline="$(tr -d '\r\n' < "$TARGET/etc/kernel/cmdline" 2>/dev/null || true)"
  if [[ -f $TARGET/boot/limine.conf && -n $cmdline ]]; then
    if awk -v c="$cmdline" '
        /^[[:space:]]*cmdline:/ { ind=$0; sub(/[^[:space:]].*$/, "", ind) }
        /^[[:space:]]*cmdline:/ {
          if ($0 ~ /root=/) { print; next }
          print ind "cmdline: " c; next
        }
        { print }
      ' "$TARGET/boot/limine.conf" > "$TARGET/boot/limine.conf.tmp"; then
      run cat "$TARGET/boot/limine.conf.tmp" > "$TARGET/boot/limine.conf" &&
        run rm -f "$TARGET/boot/limine.conf.tmp"
    fi
  fi

  register_uefi_entry
}

# Hard boot-setup gate (the omarchy validate_boot): refuse to "finish" an
# install whose boot path cannot actually boot. Checked from the live side
# against the mounted target. Returns nonzero when a gate fails so the phase
# loop can die with a precise reason instead of handing the user a brick.
validate_boot() {
  log "Validating boot setup"
  (( DRY_RUN )) && { printf '[dry-run] validate boot setup of %s\n' "$TARGET"; return 0; }

  local failures=()

  local cmdline
  cmdline="$(tr -d '\r\n' < "$TARGET/etc/kernel/cmdline" 2>/dev/null || true)"
  if [[ -z $cmdline || $cmdline != *"root="* || $cmdline == *"root=@@"* ]]; then
    failures+=("missing or empty root= in /etc/kernel/cmdline ($cmdline)")
  fi

  local default_limine="$TARGET/etc/default/limine"
  if [[ -f $default_limine ]] && grep -q 'ESP_PATH=' "$default_limine"; then
    :
  else
    failures+=("no usable ESP_PATH in /etc/default/limine")
  fi

  local limine_conf="$TARGET/boot/limine.conf"
  local esp_loader="$TARGET/boot/EFI/limine/limine_x64.efi"
  if [[ -s $limine_conf ]]; then
    local mod
    for mod in "$TARGET"/usr/lib/modules/*/; do
      [[ -d $mod ]] || continue
      [[ -f "$mod/pkgbase" ]] || continue
      local pkgbase_name mod_ver
      # The package storing a kernel exposes its base name via Linux's pkgbase
      # file inside the module dir; match the generated menu entry to it.
      mod_ver=$(basename "$mod")
      pkgbase_name=$(<"$mod/pkgbase")
      local uki="$TARGET/boot/EFI/Linux/magikos_${pkgbase_name}.efi"
      if [[ -f $uki && -s $uki ]] && grep -q "$pkgbase_name" "$limine_conf"; then
        :
      else
        failures+=("no generated menu entry/UKI for kernel $pkgbase_name ($mod_ver)")
      fi
    done
  else
    failures+=("missing empty boot/limine.conf")
  fi
  if [[ ! -s $esp_loader ]]; then
    failures+=("limine loader missing at boot/EFI/limine/limine_x64.efi")
  fi

  assert_boot_hooks_restored

  # UEFI boot-entry gate, only when this is really a UEFI machine with efivars.
  if [[ -d /sys/firmware/efi ]] && command -v efibootmgr >/dev/null 2>&1; then
    if ! efibootmgr 2>/dev/null | grep -qiE 'MagikOS|Limine'; then
      failures+=("no MagikOS/Limine entry in the UEFI boot order")
    fi
  fi

  if ((${#failures[@]} > 0)); then
    die "Boot validation failed:
$(printf '  - %s\n' "${failures[@]}")"
  fi
  log "Boot setup looks good; $(( $(ls "$TARGET"/usr/lib/modules/ 2>/dev/null | wc -l) )) kernel(s), Limine and any UKI entries verified."
}

# Freeze the freshly installed @ subvolume as @factory (read-only), the same
# origin the omarchy format freezes at the end of a successful install. Snapper
# (limine-snapper-sync / magikos snapshots) then diffs every later snapshot
# against this clean baseline instead of the first boot state.
create_factory_snapshot() {
  log "Freezing the factory snapshot (@factory)"
  (( DRY_RUN )) && { printf '[dry-run] btrfs subvolume snapshot -r <#/@> <#/@factory>\n'; return 0; }

  local dev="$ROOT_DEVICE"
  [[ -n $dev ]] || { warn "No root device known; skipping the factory snapshot."; return 0; }

  local toplevel
  toplevel=$(mktemp -d)
  if ! run mount -o subvol=/ "$dev" "$toplevel"; then
    warn "Could not mount the btrfs top level; skipping the factory snapshot."
    rm -rf "$toplevel"
    return 0
  fi

  if [[ -d $toplevel/@ && ! -e $toplevel/@factory ]]; then
    if btrfs subvolume snapshot -r "$toplevel/@/" "$toplevel/@factory" >/dev/null 2>&1; then
      btrfs property set -f -ts "$toplevel/@factory" ro true 2>/dev/null || true
      log "Created read-only factory snapshot @factory."
    else
      warn "Could not snapshot @ as @factory; continuing."
    fi
  else
    warn "Skipping factory snapshot: @ missing or @factory already present."
  fi

  run umount "$toplevel" || true
  rm -rf "$toplevel"
}

create_user() {
  log "Creating user $INSTALL_USER"

  # Neither distro repository carries oh-my-posh, so fresh installs get the
  # pinned upstream binary directly; the host-side helper only covers the
  # adopt-existing-system path.
  local omp_target="$TARGET/usr/local/bin/oh-my-posh"
  if (( DRY_RUN )) || [[ ! -x $omp_target ]]; then
    run mkdir -p "$TARGET/usr/local/bin"
    local omp_url="https://github.com/JanDeDobbeleer/oh-my-posh/releases/download/$OH_MY_POSH_VERSION/posh-linux-amd64"
    if run curl -fsSL "$omp_url" -o "$omp_target"; then
      run chmod 755 "$omp_target"
    else
      warn "Could not download oh-my-posh; fish will use its stock prompt."
      rm -f "$omp_target"
    fi
  fi

  chroot_exec "useradd -m -G wheel $(printf '%q' "$INSTALL_USER")"
  if (( ! DRY_RUN )); then
    local pass
    pass=${INSTALL_PASSWORD:-$(ask_password "Password for $INSTALL_USER")}
    # Stock PAM (no nullok) inside a freshly pacstrapped chroot is flaky:
    # chpasswd drives the full PAM stack and a missing /run/systemd or pending
    # shadow-euid state aborts with an opaque "authentication token
    # manipulation error". Write the token directly with SHA-512 instead of
    # trusting PAM to take it, so the username is verified and the password
    # lands atomically. Empty tokens are rejected here, never piped to chpasswd.
    [[ -n $pass ]] || die "Empty password for $INSTALL_USER; refusing to continue."
    printf '%s:%s\n' "$INSTALL_USER" "$pass" \
      | chroot "$TARGET" chpasswd -c SHA512 \
      || die "Could not set the password for $INSTALL_USER (chpasswd failed)."
  fi
}

ensure_chroot_dns() {
  # The install medium resolves through systemd-resolved, so /etc/resolv.conf
  # points at a loopback stub (127.0.0.53 / ::1). Go's resolver (the yay build)
  # actively reads resolv.conf and refuses stalled loopback answers, aborting
  # the AUR pass. Give the target a concrete nameserver the guest can reach:
  # pass through any non-loopback nameservers (real networks) and default to
  # the user-mode NAT gateway (qemu/vbox) when there are none.
  local -a servers=() ns
  while read -r ns; do
    [[ $ns == 127.* || $ns == "::1" ]] && continue
    servers+=("nameserver $ns")
  done < <(awk '/^nameserver/{print $2}' /etc/resolv.conf 2>/dev/null)
  ((${#servers[@]} == 0)) && servers=("nameserver 10.0.2.3")
  printf '%s\n' "${servers[@]}" > "$TARGET/etc/resolv.conf"
}

build_yay_target() {
  ensure_chroot_dns
  # Same contract as build_yay_host: the AUR build dependencies go in even
  # when yay is already present (live media that ships it), otherwise every
  # makepkg in the target fails on a missing fakeroot.
  chroot_exec "pacman -S --ask=4 --needed --noconfirm --overwrite '*' git base-devel" || \
    warn "Could not install the AUR build dependencies in the target; expect AUR build failures."

  if chroot_exec "command -v yay" >/dev/null 2>&1; then
    return 0
  fi

  log "Building yay from the AUR in the target"
  chroot_exec "pacman -S --ask=4 --needed --noconfirm --overwrite '*' go" || true

  local home_dir user_q
  user_q=$(printf '%q' "$INSTALL_USER")
  home_dir="/home/$INSTALL_USER"

  if chroot_exec "runuser -u $user_q -- env HOME=$(printf '%q' "$home_dir") \
      git clone --depth=1 $(printf '%q' "$YAY_AUR_URL") $home_dir/yay-build" &&
    chroot_exec "runuser -u $user_q -- env HOME=$(printf '%q' "$home_dir") \
      bash -c 'cd $(printf '%q' "$home_dir")/yay-build && makepkg --noconfirm -f'" &&
    chroot_exec "yes | pacman -U --noconfirm --needed $home_dir/yay-build/yay-*.pkg.tar.*"; then
    :
  else
    warn "Could not build yay in the target; AUR packages will stay missing."
    chroot_exec "rm -rf $home_dir/yay-build"
    return 1
  fi
  chroot_exec "rm -rf $home_dir/yay-build"
}

install_aur_packages_target() {
  if (( DRY_RUN )); then
    aur_candidate_names
    if (( ${#AUR_CANDIDATES[@]} > 0 )); then
      printf '[dry-run] chroot %s: yay -S --ask=4 --needed --noconfirm %s\n' "$TARGET" "${AUR_CANDIDATES[*]}"
    fi
    return 0
  fi

  if (( ${#PKG_FAILURES[@]} == 0 )); then
    return 0
  fi

  build_yay_target || return 0

  log "Retrying ${#PKG_FAILURES[@]} package(s) through the AUR (yay)"
  local aur_failed=("${PKG_FAILURES[@]}")
  local home_dir pkg user_q
  user_q=$(printf '%q' "$INSTALL_USER")
  home_dir="/home/$INSTALL_USER"
  PKG_FAILURES=()

  sudoers_nopasswd_enable "$TARGET"
  if ! chroot_exec "yes | runuser -u $user_q -- env HOME=$(printf '%q' "$home_dir") \
      yay -S --ask=4 --needed --noconfirm $(printf '%q ' "${aur_failed[@]}")"; then
    warn "Batch AUR install failed; retrying package by package."
    for pkg in "${aur_failed[@]}"; do
      chroot_exec "yes | runuser -u $user_q -- env HOME=$(printf '%q' "$home_dir") \
        yay -S --ask=4 --needed --noconfirm $(printf '%q' "$pkg")" || true
    done
  fi
  sudoers_nopasswd_disable "$TARGET"

  for pkg in "${aur_failed[@]}"; do
    chroot_exec "pacman -Q $(printf '%q' "$pkg")" >/dev/null 2>&1 || PKG_FAILURES+=("$pkg")
  done
}

apply_magikos() {
  log "Running Magikos system setup in the target"

  chroot_exec "yes | env MAGIKOS_PATH=/usr/share/magikos \
    MAGIKOS_INSTALL=/usr/share/magikos/install \
    PATH=/usr/share/magikos/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    bash /usr/share/magikos/bin/magikos-apply-system --install-user $(printf '%q' "$INSTALL_USER")"
}

# Same handoff the ISO makes after apply-system: per-user finalization runs in
# the target as the install user (--first-install marks shipped migrations
# complete). The login-triggered first-run pass later catches up the steps
# that need a live systemd user session.
finalize_user() {
  log "Finalizing per-user setup in the target"

  local home_dir="/home/$INSTALL_USER"
  if ! chroot_exec "yes | runuser -u $(printf '%q' "$INSTALL_USER") -- env \
    HOME=$(printf '%q' "$home_dir") \
    MAGIKOS_PATH=/usr/share/magikos \
    MAGIKOS_INSTALL=/usr/share/magikos/install \
    PATH=/usr/share/magikos/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    bash /usr/share/magikos/bin/magikos-provision-user --force --first-install"; then
    warn "Per-user finalization reported errors; run 'magikos finalize user' after first login."
  fi
}

report_pkg_failures() {
  if ((${#PKG_UNRESOLVABLE[@]} > 0)); then
    warn "Packages skipped, unsatisfiable dependencies on this system (${#PKG_UNRESOLVABLE[@]}):"
    printf '  %s\n' "${PKG_UNRESOLVABLE[@]}"
    echo
  fi
  if ((${#PKG_FAILURES[@]} > 0)); then
    warn "Packages that did not install (${#PKG_FAILURES[@]}):"
    printf '  %s\n' "${PKG_FAILURES[@]}"
    echo
  fi
}

finish() {
  log "Finishing up"
  run umount -R "$TARGET" || true
  if (( ENCRYPT )); then
    run cryptsetup close "$LUKS_NAME" || true
  fi

  report_pkg_failures
  printf '\n'
  log "Magikos installed on $DISK. You may reboot now."
  printf '  Next steps after rebooting:\n'
  printf '    - Log in as %s (first boot runs the per-user finalization)\n' "$INSTALL_USER"
  printf '    - Run "magikos update" to refresh packages and configs\n'
  if (( ENCRYPT )); then
    printf '    - Back up your LUKS passphrase; there is no recovery without it\n'
  fi
  if [[ ${MAGIKOS_INSTALL_LOG_FILE:-} ]]; then
    log "Install log: $MAGIKOS_INSTALL_LOG_FILE"
  fi
}

# --- Existing-system adoption (--existing): everything below runs on the
# --- live host; no chroot, no partitioning, no bootloader changes.

PLANTED="/usr/share/magikos"
OH_MY_POSH_VERSION="v30.6.5"

# A previous installer version copied default/ flat into /etc/skel; none of
# those entries belong there (default/** lives under /usr/share/magikos).
clean_stale_skel_flat_copy() {
  local name
  while IFS= read -r name; do
    if [[ -e "/etc/skel/$name" || -L "/etc/skel/$name" ]]; then
      run rm -rf -- "/etc/skel/$name"
    fi
  done < <(find "$ROOT/default" -mindepth 1 -maxdepth 1 -printf '%f\n')
}

plant_magikos_host() {
  # Running straight out of the planted tree (packaged checkout or a
  # previous adoption): rsync --delete onto ourselves would be destructive.
  if [[ $(realpath "$ROOT") == "$PLANTED" ]]; then
    log "Tree is already planted at $PLANTED"
  else
    log "Planting the Magikos tree at $PLANTED"
    run mkdir -p "$PLANTED"
    run rsync -a --delete --chown=root:root \
      --exclude '.git/' --exclude 'test/' --exclude '*.log' \
      "$ROOT/" "$PLANTED/"
  fi

  # Shipped user defaults are seeded through /etc/skel, which useradd copies
  # at account creation and seed_user_home replays for existing users.
  clean_stale_skel_flat_copy
  run mkdir -p /etc/skel
  assemble_skeleton /etc/skel
  install_app_icons ""

  link_planted_binaries "$PLANTED" ""

  # uwsm sources /usr/share/uwsm/env.d/* for the graphical session; the
  # packaged install ships this file, so recreate it here. Skip when the
  # checkout already IS the planted tree (install -D refuses same-file).
  if [[ ! "$ROOT/default/uwsm/env.d/10-magikos" -ef /usr/share/uwsm/env.d/10-magikos ]]; then
    run install -Dm644 "$ROOT/default/uwsm/env.d/10-magikos" \
      /usr/share/uwsm/env.d/10-magikos
  fi

  # systemd-environment-d-generator reads /usr/lib/environment.d/*.conf for
  # the user session; mirrors plant_magikos's full-disk path.
  run mkdir -p /usr/lib/environment.d
  run cp -a "$ROOT/default/environment.d/." /usr/lib/environment.d/

  plant_package_owned_files ""

  sync_etc_dropins /etc

  # Repair pacman configuration on systems this project installed earlier:
  # shipped channel confs once referenced package repos that are not live
  # yet, which broke every -Sy. Redeploying the current channel conf fixes
  # them.
  if grep -q "https://pkgs.magikos.org/" /etc/pacman.conf 2>/dev/null; then
    local channel=${MAGIKOS_MIRROR:-stable}
    write_file /etc/pacman.conf "$(cat "$ROOT/default/pacman/pacman-$channel.conf")"$'\n'
    write_file /etc/pacman.d/mirrorlist "$(cat "$ROOT/default/pacman/mirrorlist-$channel")"$'\n'
  fi

  write_file /etc/sudoers.d/10-magikos-wheel '%wheel ALL=(ALL:ALL) ALL'$'\n'
  if (( ! DRY_RUN )); then
    chmod 440 /etc/sudoers.d/10-magikos-wheel
  fi
}

# Split the global $packages into ${PACKAGE_REPO[@]} (names the active repos
# resolve) and everything else, which is deferred to the yay pass. Feeding a
# single unknown AUR name to a pacman batch aborts the whole transaction, so
# raw pacman must only ever see names the repos actually carry.
split_repo_and_aur() {
  local -A in_repo=()
  local name
  while read -r name; do
    [[ -n $name ]] && in_repo[$name]=1
  done < <(pacman -Slq 2>/dev/null | sort -u)
  PACKAGE_REPO=()
  local pkg
  for pkg in "${packages[@]}"; do
    if [[ ${in_repo[$pkg]+set} ]]; then
      PACKAGE_REPO+=("$pkg")
    else
      PKG_FAILURES+=("$pkg")
    fi
  done
}

install_packages_host() {
  log "Installing Magikos package set (best effort)"

  mapfile -t packages < <(grep -v '^#' "$ROOT/install/magikos-base.packages" | grep -v '^$')
  if (( ${#packages[@]} == 0 )); then
    die "No packages found in install/magikos-base.packages"
  fi

  # NVIDIA-only packages are opt-in per hardware; drop them from the set when
  # no NVIDIA GPU is present so they cannot be pulled in by the yay pass.
  if ! nvidia_present; then
    # shellcheck disable=SC2207
    mapfile -t packages < <(printf '%s\n' "${packages[@]}" | grep -vi 'nvidia')
  fi

  split_repo_and_aur
  if (( ${#PACKAGE_REPO[@]} == 0 )); then
    return 0
  fi
  # --ask=4 answers the "remove conflicting package?" prompt (yes), so a stale
  # legacy package such as chwd-db is auto-removed instead of aborting the
  # otherwise --noconfirm batch with an unresolvable conflict.
  # --overwrite '*' resolves conflicts like zlib-ng-compat vs zlib.
  if ! run pacman -S --ask=4 --needed --noconfirm --overwrite '*' "${PACKAGE_REPO[@]}"; then
    # A failed batch transaction installs nothing, so the whole set is still
    # pending. Split it first: a dry run per name separates packages whose
    # dependency closure this host cannot satisfy (systemd-bound CachyOS
    # packages on an OpenRC Artix system, for example) from the rest. The
    # unsatisfiable ones go to PKG_UNRESOLVABLE for the final report and stay
    # out of the yay pass; everything else still installs in ONE transaction
    # instead of a per-package retry over the whole set.
    local pkg resolvable=() unresolvable=()
    for pkg in "${PACKAGE_REPO[@]}"; do
      if pacman -S --print --ask=4 --noconfirm "$pkg" >/dev/null 2>&1; then
        resolvable+=("$pkg")
      else
        unresolvable+=("$pkg")
      fi
    done
    if (( ${#unresolvable[@]} > 0 )); then
      warn "Packages skipped: unsatisfiable dependencies on this system (${#unresolvable[@]}):"
      printf '  %s\n' "${unresolvable[@]}"
      PKG_UNRESOLVABLE+=("${unresolvable[@]}")
    fi
    if (( ${#resolvable[@]} > 0 )) && ! run pacman -S --ask=4 --needed --noconfirm --overwrite '*' "${resolvable[@]}"; then
      warn "Batch install failed for ${#resolvable[@]} repo package(s); retrying per-package."
      for pkg in "${resolvable[@]}"; do
        if (( DRY_RUN )); then
          printf '[dry-run] pacman -S --ask=4 --needed %s\n' "$pkg"
        elif ! pacman -S --ask=4 --needed --noconfirm --overwrite '*' "$pkg" >>"$LOG_FILE" 2>&1; then
          PKG_FAILURES+=("$pkg")
        fi
      done
    fi
  fi
}

# --- AUR follow-up -----------------------------------------------------------
# Raw pacman/pacstrap cannot satisfy AUR-only names, so whatever lands in
# PKG_FAILURES on the Arch side gets one yay pass. yay itself is built from
# the AUR when the system does not carry it yet. makepkg refuses root, so the
# build runs as the install user while pacman -U installs the result; yay's
# own privileged calls need a temporary NOPASSWD drop-in that is removed
# afterwards.

YAY_AUR_URL="https://aur.archlinux.org/yay.git"

sudoers_nopasswd_enable() {
  # The drop-in must sort AFTER 10-magikos-wheel (sudo picks the LAST matching
  # rule), otherwise the wheel ALL=ALL password rule would override the
  # NOPASSWD one and the AUR follow-up stalls on a password prompt.
  write_file "$1/etc/sudoers.d/99-magikos-installer-nopasswd" \
    '%wheel ALL=(ALL:ALL) NOPASSWD: ALL'$'\n'
  if (( ! DRY_RUN )); then
    chmod 440 "$1/etc/sudoers.d/99-magikos-installer-nopasswd"
  fi
}

sudoers_nopasswd_disable() {
  if (( ! DRY_RUN )); then
    rm -f "$1/etc/sudoers.d/99-magikos-installer-nopasswd"
  fi
}

# Fills AUR_CANDIDATES with package-list names absent from every configured
# repo — the set pacman/pacstrap cannot satisfy and yay must cover. Read-only,
# so it is also how --dry-run previews the follow-up.
aur_candidate_names() {
  local -A in_repo=()
  local name
  while read -r name; do
    [[ -n $name ]] && in_repo[$name]=1
  done < <(pacman -Slq 2>/dev/null | sort -u)
  AUR_CANDIDATES=()
  local pkg
  for pkg in "${packages[@]}"; do
    [[ ${in_repo[$pkg]+set} ]] || AUR_CANDIDATES+=("$pkg")
  done
}

build_yay_host() {
  # Every AUR build needs base-devel (fakeroot, patch, make, ...) and git, no
  # matter how yay arrived. Repos that already carry yay hit the early return
  # below, which used to skip this install and doom every AUR build with
  # "ERROR: Cannot find the fakeroot binary".
  if ! run pacman -S --ask=4 --needed --noconfirm --overwrite '*' git base-devel >>"$LOG_FILE" 2>&1; then
    warn "Could not install the AUR build dependencies (git, base-devel); expect AUR build failures."
  fi

  if command -v yay >/dev/null 2>&1; then
    return 0
  fi

  log "Building yay from the AUR (not present on this system)"
  run pacman -S --ask=4 --needed --noconfirm --overwrite '*' go >>"$LOG_FILE" 2>&1 || true

  local home_dir tmp
  home_dir=$(getent passwd "$INSTALL_USER" | cut -d: -f6)
  tmp=$(mktemp -d)
  chown "$INSTALL_USER" "$tmp"

  if runuser -u "$INSTALL_USER" -- env HOME="$home_dir" git clone --depth=1 "$YAY_AUR_URL" "$tmp/yay" &&
    runuser -u "$INSTALL_USER" -- env HOME="$home_dir" bash -c "cd '$tmp/yay' && makepkg --noconfirm -f" &&
    run pacman -U --noconfirm --needed "$tmp"/yay/yay-*.pkg.tar.*; then
    :
  else
    warn "Could not build yay; AUR packages will stay missing."
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
}

install_aur_packages_host() {
  if (( DRY_RUN )); then
    aur_candidate_names
    if (( ${#AUR_CANDIDATES[@]} > 0 )); then
      printf '[dry-run] yay -S --ask=4 --needed --noconfirm %s\n' "${AUR_CANDIDATES[*]}"
    fi
    return 0
  fi

  if (( ${#PKG_FAILURES[@]} == 0 )); then
    return 0
  fi

  build_yay_host || return 0

  log "Retrying ${#PKG_FAILURES[@]} package(s) through the AUR (yay)"
  local aur_failed=("${PKG_FAILURES[@]}")
  local home_dir pkg
  home_dir=$(getent passwd "$INSTALL_USER" | cut -d: -f6)
  PKG_FAILURES=()

  sudoers_nopasswd_enable "/"
  if ! runuser -u "$INSTALL_USER" -- env HOME="$home_dir" \
    yay -S --ask=4 --needed --noconfirm "${aur_failed[@]}" >>"$LOG_FILE" 2>&1; then
    warn "Batch AUR install failed; retrying package by package."
    for pkg in "${aur_failed[@]}"; do
      runuser -u "$INSTALL_USER" -- env HOME="$home_dir" \
        yay -S --ask=4 --needed --noconfirm "$pkg" >>"$LOG_FILE" 2>&1 || true
    done
  fi
  sudoers_nopasswd_disable "/"

  for pkg in "${aur_failed[@]}"; do
    pacman -Q "$pkg" >/dev/null 2>&1 || PKG_FAILURES+=("$pkg")
  done
}
adopt_user() {
  if (( DRY_RUN )); then
    return 0
  fi

  if id "$INSTALL_USER" >/dev/null 2>&1; then
    log "User $INSTALL_USER already exists; leaving the account as is"
    return 0
  fi

  log "Creating user $INSTALL_USER"
  run useradd -m -G wheel "$INSTALL_USER"
  local pass
  pass=${INSTALL_PASSWORD:-$(ask_password "Password for $INSTALL_USER")}
  [[ -n $pass ]] || die "Empty password for $INSTALL_USER; refusing to continue."
  printf '%s:%s\n' "$INSTALL_USER" "$pass" | run chpasswd -c SHA512 \
    || die "Could not set the password for $INSTALL_USER (chpasswd failed)."
}

run_apply_system_host() {
  log "Running Magikos system setup"

  # --first-install marks shipped migrations complete instead of replaying
  # them over an adopted system; same thing the ISO does for its fresh user.
  local cmd="env MAGIKOS_PATH=$PLANTED \
    MAGIKOS_INSTALL=$PLANTED/install \
    PATH=$PLANTED/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    bash $PLANTED/bin/magikos-apply-system --install-user $(printf '%q' "$INSTALL_USER") --first-install"

  if (( DRY_RUN )); then
    printf '[dry-run] %s\n' "$cmd"
  elif ! bash -c "$cmd"; then
    # One failing leaf aborts the whole chain (set -euo pipefail); that must
    # not lose the rest of the install.
    warn "magikos-apply-system reported errors; system setup may be incomplete."
    warn "Per-step output is in $LOG_FILE - fix and re-run this installer (it is idempotent)."
  fi
}

# useradd only replays /etc/skel for accounts it creates. An adopting user
# keeps their old $HOME until the skel tree is replayed over it (the same
# thing magikos-reinstall-configs does), then per-user finalization runs as
# that user -- it refuses root.
seed_user_home() {
  log "Syncing shipped defaults into ~$INSTALL_USER and finalizing"

  if (( DRY_RUN )); then
    printf '[dry-run] cp -af /etc/skel/. ~%s/\n' "$INSTALL_USER"
    printf '[dry-run] runuser -u %s -- magikos-provision-user --first-install\n' "$INSTALL_USER"
    return 0
  fi

  local home_dir
  home_dir=$(getent passwd "$INSTALL_USER" | cut -d: -f6)

  # --remove-destination keeps a skel file from being written *through* an
  # existing user symlink, which would truncate whatever the link targets.
  if ! runuser -u "$INSTALL_USER" -- env HOME="$home_dir" bash -c 'cp -a --remove-destination /etc/skel/. "$HOME/"'; then
    warn "Could not resync /etc/skel into ~$INSTALL_USER"
  fi

  if ! runuser -u "$INSTALL_USER" -- env \
    HOME="$home_dir" \
    MAGIKOS_PATH="$PLANTED" \
    MAGIKOS_INSTALL="$PLANTED/install" \
    PATH="$PLANTED/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    bash "$PLANTED/bin/magikos-provision-user" --first-install; then
    warn "Per-user finalization reported errors; re-run 'magikos finalize user' after first login."
  fi
}

finish_existing() {
  echo
  report_pkg_failures
  log "Magikos applied to the running system; ~$INSTALL_USER resynced from shipped defaults."
  warn "The bootloader was left untouched. Reboot into your current setup first, then adopt the UKI/Limine layout with 'magikos setup direct-boot' when ready."
  if [[ ${MAGIKOS_INSTALL_LOG_FILE:-} ]]; then
    log "Install log: $MAGIKOS_INSTALL_LOG_FILE"
  fi
}

# Neither distro's repositories carry oh-my-posh, so ship the pinned upstream
# binary when it is missing. The fish config guards its init, so systems
# without the binary simply keep the stock prompt.
install_oh_my_posh_host() {
  if command -v oh-my-posh >/dev/null 2>&1; then
    return 0
  fi

  local url="https://github.com/JanDeDobbeleer/oh-my-posh/releases/download/$OH_MY_POSH_VERSION/posh-linux-amd64"
  log "Installing oh-my-posh $OH_MY_POSH_VERSION"
  if ! run curl -fsSL "$url" -o /usr/local/bin/oh-my-posh; then
    warn "Could not download oh-my-posh; fish will use its stock prompt."
    rm -f /usr/local/bin/oh-my-posh
    return 0
  fi
  run chmod 755 /usr/local/bin/oh-my-posh
}

main() {
  preflight

  if (( EXISTING_MODE )); then
    plant_magikos_host
    enable_multilib ""
    enable_omarchy_repo ""
    if cachyos_wanted /etc/pacman.conf; then
      enable_cachyos_repos "" \
        || warn "Continuing without the CachyOS repositories."
    fi
    install_packages_host
    install_aur_packages_host
    install_oh_my_posh_host
    adopt_user
    seed_autologin /etc "$INSTALL_USER"
    run_apply_system_host
    seed_user_home
    finish_existing
    return 0
  fi

  trap unmount_target EXIT

  # Orchestrated phases, in the same spirit as the orchestrator scripts the
  # packaged ISO uses: every boot-image-affecting phase is explicitly ordered
  # so UKIs are built exactly once, by finalize_limine_boot, after the last
  # drop-in (CachyOS, autologin, Magikos system setup) has landed and after the
  # per-user pass. The target's limine/mkinitcpio hooks are masked from just
  # after pacstrap through every chrooted package phase (AUR pass, Magikos
  # system + per-user setup) so pacman cannot rebuild UKIs mid-install against
  # a cmdline that is still changing; validate_boot then refuses to call the
  # install finished on a setup that cannot boot.
  local -A PHASES=()
  local -a PHASE_ORDER=()

  local enc_label
  if (( ENCRYPT )); then
    enc_label="Partitioning $DISK (ESP + root, LUKS on)|partition_disk"
  else
    enc_label="Partitioning $DISK (ESP + root, LUKS off)|partition_disk"
  fi

  # key:label|fn is stored for step numbering; phase order defines execution.
  add_phase() {
    local key="$1" label_fn="$2"
    PHASES[$key]="$label_fn"
    PHASE_ORDER+=("$key")
  }

  add_phase part "$enc_label"
  add_phase seed "Seeding the target configuration|seed_target_config"
  add_phase bootstrap "Bootstrapping the Arch base system|bootstrap_arch"
  add_phase plant "Planting the Magikos tree in the target|plant_magikos"
  add_phase configure "Configuring the target|configure_target"
  add_phase user "Creating user $INSTALL_USER|create_user"
  add_phase aur "Installing AUR packages (yay)|install_aur_packages_target"
  add_phase apply "Applying Magikos system setup|apply_magikos"
  add_phase finalize "Finalizing per-user setup|finalize_user"
  add_phase limine "Finalizing the Limine bootloader|finalize_limine_boot"
  add_phase validate "Validating the boot setup|validate_boot"
  add_phase snapshot "Freezing the factory snapshot|create_factory_snapshot"

  TOTAL_STEPS=${#PHASE_ORDER[@]}
  local key entry label fn
  for key in "${PHASE_ORDER[@]}"; do
    entry=${PHASES[$key]}
    label=${entry%%|*}
    fn=${entry#*|}

    # The target's hook tree only exists once pacstrap has run; masking before
    # then is a no-op. The very first chrooted package phase is where repeated
    # mid-install UKI rebuilds would otherwise start, so mask right before it.
    if [[ $key == "aur" ]]; then
      mask_target_boot_hooks
    fi

    step "$label"
    case $fn in
      create_user)
        create_user
        seed_autologin "$TARGET/etc" "$INSTALL_USER"
        ;;
      *)
        "$fn"
        ;;
    esac
  done

  trap - EXIT
  finish
}

main
